;; A show saved before zones Z4, on this rig: items, groups and nested
;; groups routed by their own :zone-group-id, the rest inheriting from their
;; group or the cue. legacy-shows-test adds the rig's projectors.
{"project-metadata.edn"
 {:config {}
  :timing {:bpm 120.0}
  :grid {:size [8 4]}}

 "hardware.edn"
 {:rig {:order [:p1 :p2 :p3 :p4 :p5] :middle :split :split-width 0.75}
  :zone-groups {:graphics {:id :graphics :name "Graphics" :color "#9B59B6"}
                :crowd {:id :crowd :name "Crowd Scanning" :color "#E67E22"}
                :left {:id :left :name "Left (manual)" :color "#4A90D9"}}}

 "content.edn"
 {:chains
  {:cue-chains
   {[0 0] {:name "Item beats the cue" :destination-zone {:zone-group-id :graphics}
           :items [{:id "z00a" :type :preset :preset-id :circle :enabled? true :zone-group-id :auto/right
                    :params {:num-points 10} :effects []}
                   {:id "z00b" :type :preset :preset-id :square :enabled? true :params {:num-points 8} :effects []}]}
    [1 0] {:name "Group and its children"
           :items [{:id "z10g" :type :group :name "Pair" :enabled? true :zone-group-id :auto/odd
                    :effects [{:id "z10g-fx" :effect-id :scale :enabled? true
                               :params {:x-scale {:type :sine :min 0.6 :max 1.0 :period 2.0} :y-scale 0.8}}]
                    :items [{:id "z10a" :type :preset :preset-id :circle :enabled? true :params {:num-points 9} :effects []}
                            {:id "z10b" :type :preset :preset-id :triangle :enabled? true :zone-group-id :auto/even
                             :params {:num-points 6} :effects []}]}
                   {:id "z10c" :type :preset :preset-id :star :enabled? true :params {:num-points 5} :effects []}]}
    [2 0] {:name "Nested groups" :destination-zone {:zone-group-id :auto/left}
           :items [{:id "z20g" :type :group :name "Outer" :enabled? true
                    :items [{:id "z20h" :type :group :name "Inner" :enabled? true :zone-group-id :crowd
                             :items [{:id "z20a" :type :preset :preset-id :wave :enabled? true :params {:num-points 8} :effects []}]}
                            {:id "z20b" :type :preset :preset-id :square :enabled? true :params {:num-points 4}
                             :effects [{:id "z20b-fx" :effect-id :rotation :enabled? true
                                        :params {:angle {:type :sine :min 0.0 :max 90.0 :period 4.0}}}]}]}]}
    [3 0] {:name "A disabled item" :destination-zone {:zone-group-id :auto/center}
           :items [{:id "z30a" :type :preset :preset-id :circle :enabled? false :zone-group-id :graphics
                    :params {:num-points 12} :effects []}
                   {:id "z30b" :type :preset :preset-id :horizontal-line :enabled? true :params {:num-points 6} :effects []}]}
    [4 0] {:name "Manual Left and a laser"
           :items [{:id "z40a" :type :preset :preset-id :beam-fan :enabled? true :zone-group-id :left
                    :params {:num-points 4} :effects []}
                   {:id "z40b" :type :preset :preset-id :circle :enabled? true :zone-group-id :auto.laser/p1
                    :params {:num-points 8 :radius 0.4} :effects []}
                   {:id "z40c" :type :preset :preset-id :triangle :enabled? true :zone-group-id :auto/right
                    :params {:num-points 6} :effects []}]}
    [5 0] {:name "Group effects across zones" :destination-zone {:zone-group-id :all}
           :items [{:id "z50g" :type :group :name "Coloured" :enabled? true
                    :effects [{:id "z50g-fx" :effect-id :set-color :enabled? true :params {:red 1.0 :green 0.2 :blue 0.0}}]
                    :items [{:id "z50a" :type :preset :preset-id :circle :enabled? true :zone-group-id :auto/left
                             :params {:num-points 6} :effects []}
                            {:id "z50b" :type :preset :preset-id :square :enabled? true :zone-group-id :auto/right
                             :params {:num-points 4} :effects []}
                            {:id "z50c" :type :preset :preset-id :star :enabled? true :params {:num-points 5} :effects []}]}]}}
   :effect-chains {}}}}
