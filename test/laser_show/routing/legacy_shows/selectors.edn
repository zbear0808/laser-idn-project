;; A show saved before zones Z4, on this rig: items routed by Zone Selector
;; effects (enabled or not, two on one item, one inside an effect group, one
;; with keyframes, one on a group), and an effects-grid cell holding one,
;; which routing never read. legacy-shows-test adds the rig's projectors.
{"project-metadata.edn"
 {:config {}
  :timing {:bpm 120.0}
  :grid {:size [8 4]}}

 "hardware.edn"
 {:rig {:order [:p1 :p2 :p3 :p4 :p5] :middle :split :split-width 0.75}
  :zone-groups {:graphics {:id :graphics :name "Graphics" :color "#9B59B6"}
                :crowd {:id :crowd :name "Crowd Scanning" :color "#E67E22"}
                :left {:id :left :name "Left (manual)" :color "#4A90D9"}}}

 "content.edn"
 {:chains
  {:cue-chains
   {[0 0] {:name "Selector to Left" :destination-zone {:zone-group-id :all}
           :items [{:id "s00" :type :preset :preset-id :circle :enabled? true :params {:num-points 10}
                    :effects [{:id "s00-z" :effect-id :zone-selector :enabled? true :params {:target-zone :auto/left}}
                              {:id "s00-fx" :effect-id :scale :enabled? true :params {:x-scale 0.5 :y-scale 0.5}}]}]}
    [1 0] {:name "A disabled selector" :destination-zone {:zone-group-id :auto/right}
           :items [{:id "s10" :type :preset :preset-id :square :enabled? true :params {:num-points 8}
                    :effects [{:id "s10-z" :effect-id :zone-selector :enabled? false :params {:target-zone :graphics}}]}]}
    [2 0] {:name "Two selectors"
           :items [{:id "s20" :type :preset :preset-id :triangle :enabled? true :params {:num-points 9}
                    :effects [{:id "s20-z1" :effect-id :zone-selector :enabled? true :params {:target-zone :auto/right}}
                              {:id "s20-z2" :effect-id :zone-selector :enabled? true :params {:target-zone :graphics}}]}]}
    [3 0] {:name "The first one off" :destination-zone {:zone-group-id :graphics}
           :items [{:id "s30" :type :preset :preset-id :star :enabled? true :params {:num-points 5}
                    :effects [{:id "s30-z1" :effect-id :zone-selector :enabled? false :params {:target-zone :crowd}}
                              {:id "s30-z2" :effect-id :zone-selector :enabled? true :params {:target-zone :auto/center}}]}]}
    [4 0] {:name "The first one has no zone" :destination-zone {:zone-group-id :auto/odd}
           :items [{:id "s40" :type :preset :preset-id :wave :enabled? true :params {:num-points 8}
                    :effects [{:id "s40-z1" :effect-id :zone-selector :params {}}
                              {:id "s40-z2" :effect-id :zone-selector :enabled? true :params {:target-zone :graphics}}]}]}
    [5 0] {:name "Its own zone beats its selector"
           :items [{:id "s50" :type :preset :preset-id :circle :enabled? true :zone-group-id :auto/even :params {:num-points 7}
                    :effects [{:id "s50-z" :effect-id :zone-selector :enabled? true :params {:target-zone :graphics}}]}]}
    [6 0] {:name "A group's selector" :destination-zone {:zone-group-id :crowd}
           :items [{:id "s60g" :type :group :name "Sealed" :enabled? true
                    :effects [{:id "s60g-z" :effect-id :zone-selector :enabled? true :params {:target-zone :auto/left}}]
                    :items [{:id "s60a" :type :preset :preset-id :circle :enabled? true :params {:num-points 8}
                             :effects [{:id "s60a-z" :effect-id :zone-selector :enabled? true :params {:target-zone :auto/right}}]}
                            {:id "s60b" :type :preset :preset-id :square :enabled? true :params {:num-points 4} :effects []}]}
                   {:id "s60c" :type :preset :preset-id :triangle :enabled? true :params {:num-points 6} :effects []}]}
    [7 0] {:name "Inside an effect group" :destination-zone {:zone-group-id :auto/even}
           :items [{:id "s70" :type :preset :preset-id :star :enabled? true :params {:num-points 6}
                    :effects [{:id "s70-g" :type :group :name "Effects" :enabled? true
                               :items [{:id "s70-z" :effect-id :zone-selector :enabled? true :params {:target-zone :crowd}}
                                       {:id "s70-fx" :effect-id :rotation :enabled? true :params {:angle 30.0}}]}]}]}
    [0 1] {:name "A selector with keyframes"
           :items [{:id "s01" :type :preset :preset-id :circle :enabled? true :params {:num-points 9}
                    :effects [{:id "s01-z" :effect-id :zone-selector :enabled? true :params {:target-zone :left}
                               :keyframe-modulator {:enabled? true :period 4.0 :time-unit :beats
                                                    :keyframes [{:position 0.0 :params {:target-zone :graphics}}
                                                                {:position 0.5 :params {:target-zone :crowd}}]}}]}]}
    [1 1] {:name "Selector, no :enabled?" :destination-zone {:zone-group-id :graphics}
           :items [{:id "s11" :type :preset :preset-id :beam-fan :enabled? true :params {:num-points 4}
                    :effects [{:id "s11-z" :effect-id :zone-selector :params {:target-zone :auto/right}}]}]}}
   :effect-chains
   {[1 2] {:active? true
           :items [{:id "e12-z" :effect-id :zone-selector :enabled? true :params {:target-zone :crowd}}
                   {:id "e12-fx" :effect-id :hue-shift :enabled? true :params {:degrees {:type :sine :min 0.0 :max 60.0 :period 2.0}}}]}
    [2 2] {:active? false
           :items [{:id "e22-z" :effect-id :zone-selector :enabled? true :params {:target-zone :graphics}}]}}}}}
