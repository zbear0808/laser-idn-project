;; A show saved before zones Z4, on this rig: timeline cues whose tracks,
;; folders and clips carry :zone-group-id (a folder's zone reaching its
;; tracks, a clip's own beating its track's, a muted track, a group clip, a
;; folder's effects, a loop), tracks in the old flat form (:path and
;; :parent-id), and a plain cue with tracks. legacy-shows-test adds the
;; rig's projectors.
{"project-metadata.edn"
 {:config {}
  :timing {:bpm 120.0}
  :grid {:size [8 4]}}

 "hardware.edn"
 {:rig {:order [:p1 :p2 :p3 :p4 :p5] :middle :split :split-width 0.75}
  :zone-groups {:graphics {:id :graphics :name "Graphics" :color "#9B59B6"}
                :crowd {:id :crowd :name "Crowd Scanning" :color "#E67E22"}
                :left {:id :left :name "Left (manual)" :color "#4A90D9"}}}

 "content.edn"
 {:chains
  {:cue-chains
   {[0 0] {:name "Beat" :editor-type :timeline :destination-zone {:zone-group-id :auto/center}
           :tracks [{:id "f1" :type :group :name "Left side" :zone-group-id :auto/left :collapsed? false
                     :effects [{:id "f1-fx" :effect-id :set-color :enabled? true :params {:red 0.0 :green 1.0 :blue 0.5}}]
                     :items [{:id "t1" :type :track :name "Kick"}
                             {:id "t2" :type :track :name "Snare" :zone-group-id :graphics}]}
                    {:id "t3" :type :track :name "Lead"}
                    {:id "t4" :type :track :name "Muted" :zone-group-id :crowd :muted? true}]
           :items [{:id "c1" :type :preset :preset-id :circle :enabled? true :track-id "t1"
                    :timeline/start 0.0 :timeline/duration 4.0 :params {:num-points 8} :effects []}
                   {:id "c2" :type :preset :preset-id :square :enabled? true :track-id "t2"
                    :timeline/start 0.0 :timeline/duration 8.0 :params {:num-points 6}
                    :effects [{:id "c2-fx" :effect-id :rotation :enabled? true
                               :params {:angle {:type :sine :min 0.0 :max 180.0 :period 2.0}}}]}
                   {:id "c3" :type :preset :preset-id :triangle :enabled? true :track-id "t3" :zone-group-id :auto/right
                    :timeline/start 1.0 :timeline/duration 6.0 :params {:num-points 6} :effects []}
                   {:id "c4" :type :preset :preset-id :star :enabled? true :track-id "t3"
                    :timeline/start 0.0 :timeline/duration 16.0 :params {:num-points 5}
                    :effects [{:id "c4-z" :effect-id :zone-selector :enabled? true :params {:target-zone :crowd}}]}
                   {:id "c5" :type :preset :preset-id :wave :enabled? true :track-id "t4"
                    :timeline/start 0.0 :timeline/duration 8.0 :params {:num-points 6} :effects []}
                   {:id "c6" :type :group :name "Clip group" :enabled? true :track-id "t1" :zone-group-id :auto/odd
                    :timeline/start 6.0 :timeline/duration 4.0
                    :items [{:id "c6a" :type :preset :preset-id :circle :enabled? true :params {:num-points 6} :effects []}
                            {:id "c6b" :type :preset :preset-id :square :enabled? true :zone-group-id :auto/even
                             :params {:num-points 4} :effects []}]}]}
    [1 0] {:name "Old flat tracks" :editor-type :timeline :destination-zone {:zone-group-id :all}
           :tracks [{:id "pf" :type :folder :name "Folder" :zone-group-id :auto/right :path []}
                    {:id "pt" :type :track :name "In the folder" :path ["pf"]}
                    {:id "pu" :type :track :name "Parented" :parent-id "pf"}
                    {:id "pv" :type :track :name "On its own"}]
           :items [{:id "p1" :type :preset :preset-id :circle :enabled? true :track-id "pt"
                    :timeline/start 0.0 :timeline/duration 8.0 :params {:num-points 7} :effects []}
                   {:id "p2" :type :preset :preset-id :square :enabled? true :track-id "pu"
                    :timeline/start 0.0 :timeline/duration 8.0 :params {:num-points 5} :effects []}
                   {:id "p3" :type :preset :preset-id :triangle :enabled? true :track-id "pv"
                    :timeline/start 0.0 :timeline/duration 8.0 :params {:num-points 4} :effects []}]}
    [2 0] {:name "A loop" :editor-type :timeline
           :loop {:enabled? true :start 0.0 :duration 4.0}
           :tracks [{:id "l1" :type :track :name "A" :zone-group-id :auto/left}
                    {:id "l2" :type :track :name "B"}]
           :items [{:id "lc1" :type :preset :preset-id :circle :enabled? true :track-id "l1"
                    :timeline/start 0.0 :timeline/duration 2.0 :params {:num-points 6} :effects []}
                   {:id "lc2" :type :preset :preset-id :star :enabled? true :track-id "l2" :zone-group-id :auto.laser/p2
                    :timeline/start 2.0 :timeline/duration 2.0 :params {:num-points 5} :effects []}
                   {:id "lc3" :type :preset :preset-id :wave :enabled? true :track-id "l2"
                    :timeline/start 0.0 :timeline/duration 4.0 :params {:num-points 6} :effects []}]}
    [3 0] {:name "A plain cue with tracks" :destination-zone {:zone-group-id :crowd}
           :tracks [{:id "x1" :type :track :name "Graphics" :zone-group-id :graphics}]
           :items [{:id "x1c" :type :preset :preset-id :circle :enabled? true :track-id "x1" :params {:num-points 8} :effects []}
                   {:id "x2c" :type :preset :preset-id :square :enabled? true :track-id "nowhere" :params {:num-points 4} :effects []}
                   {:id "x3c" :type :preset :preset-id :triangle :enabled? true :params {:num-points 5} :effects []}]}}
   :effect-chains {}}}}
